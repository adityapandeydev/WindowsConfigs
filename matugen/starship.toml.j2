style = "bg:{{colors.primary_container.default.hex}}"
format = '[[ $symbol( $version) ](fg:{{colors.on_primary_container.default.hex}} bg:{{colors.primary_container.default.hex}})]($style)'

[elixir]
symbol = ""
style = "bg:{{colors.primary_container.default.hex}}"
format = '[[ $symbol( $version) ](fg:{{colors.on_primary_container.default.hex}} bg:{{colors.primary_container.default.hex}})]($style)'

[gradle]
symbol = ""
style = "bg:{{colors.primary_container.default.hex}}"
format = '[[ $symbol( $version) ](fg:{{colors.on_primary_container.default.hex}} bg:{{colors.primary_container.default.hex}})]($style)'

[zig]
symbol = ""
style = "bg:{{colors.primary_container.default.hex}}"
format = '[[ $symbol( $version) ](fg:{{colors.on_primary_container.default.hex}} bg:{{colors.primary_container.default.hex}})]($style)'

[nix_shell]
symbol = ""
style = "bg:{{colors.primary_container.default.hex}}"
format = '[[ $symbol( $version) ](fg:{{colors.on_primary_container.default.hex}} bg:{{colors.primary_container.default.hex}})]($style)'

[docker_context]
symbol = ""
style = "bg:{{colors.secondary_container.default.hex}}"
format = '[[ $symbol( $context) ](fg:{{colors.on_secondary_container.default.hex}} bg:{{colors.secondary_container.default.hex}})]($style)'

[conda]
symbol = " "
style = "bg:{{colors.secondary_container.default.hex}}"
format = '[[ $symbol( $environment) ](fg:{{colors.on_secondary_container.default.hex}} bg:{{colors.secondary_container.default.hex}})]($style)'

[time]
disabled = false
time_format = "%R"
style = "bg:{{colors.tertiary_container.default.hex}}"
format = '[[  $time ](fg:{{colors.on_tertiary_container.default.hex}} bg:{{colors.tertiary_container.default.hex}})]($style)'

[line_break]
disabled = false

[character]
disabled = false
success_symbol = '[[➜](bold fg:{{colors.primary.default.hex}}) ❯]({{colors.secondary.default.hex}})'
error_symbol = '[[➜](bold fg:{{colors.error.default.hex}}) ❯]({{colors.secondary.default.hex}})'
vimcmd_symbol = '[](bold fg:{{colors.primary.default.hex}})'
vimcmd_replace_one_symbol = '[](bold fg:{{colors.error.default.hex}})'
vimcmd_replace_symbol = '[](bold fg:{{colors.error.default.hex}})'
vimcmd_visual_symbol = '[](bold fg:{{colors.secondary.default.hex}})'
